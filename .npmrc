engine-strict=false

# Media player (@vbirukov scope) via GitHub Packages.
# Токен задаётся глобально: npm config set //npm.pkg.github.com/:_authToken <PAT>
# (либо через env NPM_AUTH_TOKEN для CI). Не дублировать сюда —
# локальный .npmrc перекрывает глобальный конфиг.
@vbirukov:registry=https://npm.pkg.github.com
