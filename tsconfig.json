{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "main.tsx",
    "embed.tsx",
    "src/App.tsx",
    "src/player/**/*",
    "src/app/**/*",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/lib/**/*",
    "src/data/**/*",
    "src/types/catalog.ts",
    "src/vite-env.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
