{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": "."
  },
  "include": [
    "main.tsx",
    "embed.tsx",
    "src/App.tsx",
    "src/app/**/*",
    "src/data/**/*",
    "src/vite-env.d.ts",
    "src/components/MainHeader.tsx",
    "src/components/LibraryHero.tsx",
    "src/components/AuthorPhotoSlideshow.tsx",
    "src/components/BrandLogo.tsx",
    "src/hooks/useAuthorPhotoSlideshow.ts",
    "src/hooks/useFeedGridDesktop.ts",
    "src/lib/authorPhotos.ts",
    "vite.config.ts"
  ]
}
